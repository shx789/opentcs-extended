# Image tags loaded on the server (must match local build tags).
IMAGE_TAG=1.0

# Host port mappings (change if ports are already in use on the server).
# MQTT_HOST_PORT=1883
# KERNEL_HOST_PORT=55200
# RCS_HOST_PORT=8090

# Cloud ECS may require relaxed seccomp for Java (pthread_create EPERM).
# DOCKER_SECCOMP_UNCONFINED=true

# If host port 1883 already has MQTT (EMQX/Mosquitto), skip the mqtt container:
# SKIP_MQTT=true
# EXTERNAL_MQTT_HOST=172.17.0.1

# RCS integration overrides (optional).
RCS_AGV_POINT_ID_MAP=Point-0020=20,Point-0026=26
RCS_AGV_COMMAND_TOPIC=robot_control
RCS_AGV_MQTT_TOPIC=robot_status

# WCS callback targets on the host (adjust for your environment).
# RCS_WMS_BASE_URL=http://host.docker.internal:8080
# RCS_CALLBACK_BASE_URL=http://host.docker.internal:8080
