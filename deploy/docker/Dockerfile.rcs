# SPDX-License-Identifier: MIT
#
# Base images: jammy tags are widely mirrored (noble may be missing on some mirrors).
# Gradle: uses deploy/docker/scripts/docker-gradle-build.sh (mirror + longer timeout).
# Fallback: Dockerfile.rcs.host (build with -HostGradle on the host first).

ARG JDK_IMAGE=eclipse-temurin:21-jdk-jammy
ARG JRE_IMAGE=eclipse-temurin:21-jre-jammy
ARG GRADLE_DISTRIBUTION_URL=https://mirrors.cloud.tencent.com/gradle/gradle-8.14.4-bin.zip

FROM ${JDK_IMAGE} AS build
ARG GRADLE_DISTRIBUTION_URL
ENV GRADLE_DISTRIBUTION_URL=${GRADLE_DISTRIBUTION_URL}
WORKDIR /src
COPY . .
RUN chmod +x deploy/docker/scripts/docker-gradle-build.sh \
 && deploy/docker/scripts/docker-gradle-build.sh :opentcs-rcs-integration-sample:shadowJar -x test

FROM ${JRE_IMAGE}
WORKDIR /app
COPY --from=build /src/opentcs-rcs-integration-sample/build/libs/opentcs-rcs-integration-sample-*-all.jar /app/app.jar
EXPOSE 8090
ENV RCS_STORE_MODE=file
ENV RCS_STORE_FILE_DIR=/data/rcs-store
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
CMD ["8090"]
