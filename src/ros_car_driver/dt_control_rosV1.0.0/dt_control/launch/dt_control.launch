<launch>
  <node pkg="dt_control" type="dt_control_node" name="dt_control_node" output="screen">

    <param name="dt_port" type="string" value="/dev/ttyS7"/>
    <param name="dt_baudrate" type="int" value="115200"/>

    <param name="dt_odom_enable" type="bool" value="true"/>

    <param name="dt_log_display" type="bool" value="false"/>
    <param name="dt_original_display" type="bool" value="false"/>

    <param name="dt_info_display" type="bool" value="false"/>
    <param name="dt_info_display_time" type="int" value="2"/>
    
    <remap from="/dt/velocity_ctrl" to="/cmd_vel" />
  </node>
</launch>
