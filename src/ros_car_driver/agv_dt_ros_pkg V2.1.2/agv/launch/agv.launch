<launch>
  <node pkg="agv" type="agv_node" name="agv_node" output="screen">

    <param name="agv_port" type="string" value="/dev/ttyS7"/>
    <param name="agv_baudrate" type="int" value="115200"/>

    <param name="agv_odom_enable" type="bool" value="false"/>

    <param name="agv_state_display" type="bool" value="false"/>

    <param name="agv_info_display" type="bool" value="false"/>
    <param name="agv_info_display_time" type="int" value="2"/>

    <remap from="/agv_velocity" to="/cmd_vel" />

  </node>
</launch>
