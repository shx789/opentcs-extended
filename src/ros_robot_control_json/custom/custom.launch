<launch>
  <!--static_transform_publisher x y z yaw pitch roll frame_id child_frame_id-->
  <node pkg="tf" type="static_transform_publisher" name="base_to_link"      args="0 0 0 0 0 0 base_footprint base_link 10" />
  <node pkg="tf" type="static_transform_publisher" name="base_to_gyro"      args="0 0 0 0 0 0 base_footprint gyro_link 10" />
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"     args="0.28 0 0.25 0 0 3.1415926 base_footprint laser 10" />
  <!--<node pkg="tf" type="static_transform_publisher" name="base_to_camera"    args="0.36 -0.035 0.19 1.570796 3.1415926 1.570796 base_footprint camera_link 10" />-->
</launch>
