# Runtime hot-reload config. Adapter checks this JSON while running.
AGV_ADAPTER_RUNTIME_CONFIG_FILE=.\config\runtime_config.json

# MQTT broker used by the third-party AGV and RCS.
AGV_ADAPTER_MQTT_URI=mqtt://127.0.0.1:1883/

# openTCS HTTP API base URL.
AGV_ADAPTER_OPENTCS_URL=http://127.0.0.1:55200

# RCS sample app URL. Used only for optional command-context inference.
AGV_ADAPTER_RCS_URL=http://127.0.0.1:8080

# openTCS vehicle name to update.
AGV_ADAPTER_VEHICLE_NAME=Vehicle-01

# Native AGV feedback topic. Third-party AGV code already publishes this topic.
AGV_ADAPTER_SOURCE_TOPIC=task_feedback

# Optional command topic listened by the adapter for mission context.
AGV_ADAPTER_COMMAND_TOPIC=robot_control

# Leave empty in normal deployment. Set only if adapter should forward commands to another topic.
AGV_ADAPTER_FORWARD_COMMAND_TOPIC=

# Mapping file used by the adapter.
AGV_ADAPTER_MAPPING_FILE=.\config\agv_opentcs_business_topology_draft.json

# AGV native task type/id -> openTCS point name mapping.
# Prefer type:id to avoid conflicts, e.g. nav:0 and charge:0 can map to different points.
# Plain 0=WAIT_WEST is still supported as wildcard *:0 for compatibility.
AGV_ADAPTER_POINT_ID_MAP=nav:0=WAIT_WEST,nav:1=WAIT_EAST,point:0=WAIT_WEST,point:1=WAIT_EAST

# Optional AGV point JSON for deriving id mapping when AGV point file is available.
AGV_ADAPTER_AGV_POINT_FILE=.\config\interest_point.sample.json

# Coordinate fallback tolerance in meters.
AGV_ADAPTER_DISTANCE_TOLERANCE_M=1.2

# Whether to publish normalized RCS event topic agv/{agv_id}/task/events.
# Set to true only if RCS should consume events from the adapter instead of another bridge.
AGV_ADAPTER_PUBLISH_RCS_EVENT=false

# Runtime status JSON written by the adapter.
AGV_ADAPTER_STATUS_FILE=.\logs\agv_native_feedback_adapter_status.json
