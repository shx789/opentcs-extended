[Unit]
Description=openTCS RCS integration sample
After=network-online.target opentcs-kernel.service
Wants=network-online.target

[Service]
Type=simple
User=opentcs
Group=opentcs
WorkingDirectory=/opt/opentcs-agv
Environment=AGV_SUITE_ENV=/opt/opentcs-agv/deploy-linux/config/agv-suite.env
Environment=AGV_FOREGROUND=1
ExecStart=/opt/opentcs-agv/deploy-linux/scripts/start-rcs.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
