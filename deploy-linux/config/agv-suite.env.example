# Copy this file to agv-suite.env and adjust values for the Linux server.

AGV_SUITE_HOME=/opt/opentcs-agv
PROJECT_HOME=/opt/opentcs-agv/opentcs
OPENTCS_HOME=/opt/opentcs-agv/runtime/opentcs
ADAPTER_ROOT=/opt/opentcs-agv/opentcs/agv-opentcs-adapter-windows
DASHBOARD_ROOT=/opt/opentcs-agv/opentcs/map_mapping_output
LOG_DIR=/opt/opentcs-agv/logs

# Java / Python
JAVA_BIN=java
PYTHON_BIN=python3

# openTCS kernel HTTP service. Keep this local if RCS runs on the same machine.
OPENTCS_HTTP_URL=http://127.0.0.1:55200

# RCS HTTP service.
RCS_HTTP_HOST=0.0.0.0
RCS_HTTP_PORT=8090
RCS_HTTP_URL=http://127.0.0.1:8090

# Web pages.
CONFIG_WEB_HOST=0.0.0.0
CONFIG_WEB_PORT=8091
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8092

# Real AGV MQTT broker.
# Usually this is the robot-side IP after the server joins the AGV WiFi/LAN.
AGV_MQTT_HOST=192.168.10.100
AGV_MQTT_PORT=1883
AGV_MQTT_URI=tcp://192.168.10.100:1883
AGV_MQTT_URI_WEB=mqtt://192.168.10.100:1883/
AGV_COMMAND_TOPIC=robot_control
AGV_FEEDBACK_TOPIC=task_feedback
AGV_ID=AGV_01

# Native AGV type/id -> openTCS point name mapping.
# Example from protocol: type=nav,id=0 maps to ST_IN_01.
AGV_POINT_ID_MAP=nav:0=ST_IN_01,point:0=ST_IN_01,nav:1=P_WAIT_IN_01,point:1=P_WAIT_IN_01

# openTCS vehicle.
OPENTCS_VEHICLE_NAME=Vehicle-01

# Optional direct command overrides. Leave empty unless your packaged command differs.
# OPENTCS_KERNEL_CMD="/opt/opentcs-agv/runtime/opentcs/bin/startKernel.sh"
# RCS_CMD="java -Drcs.openTcs.baseUrl=http://127.0.0.1:55200 -jar /opt/opentcs-agv/opentcs/opentcs-rcs-integration-sample/build/libs/opentcs-rcs-integration-sample-7.3.0-SNAPSHOT-all.jar --port=8090"
